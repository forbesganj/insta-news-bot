# Copy to .env for LOCAL runs only (never commit .env). In GitHub use Settings > Secrets and variables.
# --- behaviour (repository VARIABLES in GitHub, not secrets) ---
DRY_RUN=true                 # true = never publish to Instagram. Set to false only when you are ready.
APPROVAL_MODE=telegram       # telegram | auto_low_risk | auto

# --- LLM: set ONE (secrets) ---
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=                 # optional model override

# --- voice (optional; without any, videos are silent text reels) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=       # e.g. centralindia
# GOOGLE_TTS_API_KEY=
# TTS_PROVIDER=auto

# --- visuals (optional) ---
# PEXELS_API_KEY=

# --- public video hosting (needed for real publishing) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=reels

# --- Instagram (needed for real publishing + analytics) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- approvals / alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- token auto-refresh workflow only (GitHub secret, never in .env) ---
# GH_PAT=
